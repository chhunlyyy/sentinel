{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.dev/schema/config.schema.json",
  "title": "Sentinel config",
  "type": "object",
  "required": [
    "version",
    "shape",
    "repos"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "shape": {
      "enum": [
        "single",
        "fullstack",
        "fullstack-mobile",
        "custom"
      ]
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "role",
          "profile"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "profile": {
            "type": "string"
          },
          "commands": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "build": {
                "type": "string"
              },
              "lint": {
                "type": "string"
              },
              "typecheck": {
                "type": "string"
              },
              "test": {
                "type": "string"
              },
              "mutate": {
                "type": "string"
              }
            }
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guidelines": {
            "type": "string"
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "enum": [
            "playwright",
            "emulator",
            "native",
            "none"
          ]
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "start_commands": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "db_clone": {
          "oneOf": [
            {
              "const": "none"
            },
            {
              "type": "object",
              "required": [
                "engine",
                "connection",
                "databases"
              ],
              "additionalProperties": false,
              "properties": {
                "engine": {
                  "enum": [
                    "mysql"
                  ]
                },
                "connection": {
                  "type": "object",
                  "required": [
                    "env_file"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "env_file": {
                      "type": "string"
                    },
                    "url_var": {
                      "type": "string"
                    },
                    "host_var": {
                      "type": "string"
                    },
                    "port_var": {
                      "type": "string"
                    },
                    "user_var": {
                      "type": "string"
                    },
                    "password_var": {
                      "type": "string"
                    }
                  }
                },
                "databases": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "source",
                      "target"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "target": {
                        "type": "string"
                      },
                      "refresh": {
                        "enum": [
                          "always",
                          "if_missing"
                        ]
                      }
                    }
                  }
                },
                "fresh": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "replaces": {
                      "type": "string"
                    }
                  }
                },
                "throwaway_suffixes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "storage_dirs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "boot_args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "fixtures": {
          "enum": [
            "sanitized",
            "clone"
          ]
        }
      }
    },
    "release_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "single_model": {
      "type": "boolean",
      "default": true
    },
    "routing": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "runner"
        ],
        "additionalProperties": false,
        "properties": {
          "runner": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        }
      }
    },
    "runners": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prompt_flag": {
            "type": "string"
          },
          "input": {
            "enum": [
              "arg",
              "stdin"
            ]
          },
          "model_flag": {
            "type": "string"
          },
          "resume_flag": {
            "type": "string"
          },
          "session_field": {
            "type": "string"
          },
          "output": {
            "enum": [
              "text",
              "json_response"
            ]
          },
          "supports_subagents": {
            "type": "boolean"
          },
          "unsafe_skip_permissions": {
            "type": "boolean"
          },
          "unsafe_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "add_dir_flag": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no_code_comments": {
          "type": "boolean",
          "default": false
        },
        "no_em_dashes": {
          "type": "boolean",
          "default": false
        },
        "no_coauthor_trailer": {
          "type": "boolean",
          "default": false
        },
        "agents_never_run_git": {
          "type": "boolean",
          "default": false
        },
        "no_permanent_frontend_tests": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_rounds": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "qa_rounds": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "release_check_rounds": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "default": ".sentinel"
        },
        "auto_sync_push": {
          "type": "boolean",
          "default": false
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 1,
              "default": 20
            },
            "logs_days": {
              "type": "integer",
              "minimum": 1,
              "default": 14
            }
          }
        },
        "shared_repo": {
          "type": "string",
          "minLength": 1
        },
        "shared_ref": {
          "type": "string"
        },
        "shared_mode": {
          "type": "string",
          "enum": [
            "git",
            "local"
          ],
          "default": "git"
        }
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "gitea",
            "github",
            "gitlab",
            "jira"
          ]
        },
        "url": {
          "type": "string"
        }
      }
    },
    "extra_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "added_lines",
              "changed_paths"
            ]
          },
          "repo": {
            "type": "string"
          },
          "path_regex": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "exclude_path_regex": {
            "type": "string"
          },
          "exclude_line_regex": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "any",
              "modified",
              "added"
            ]
          },
          "must_match": {
            "type": "string"
          }
        }
      }
    },
    "stage_guidelines": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
