{
  "id": "node",
  "detect": [
    "package.json"
  ],
  "commands": {
    "build": "npm run build",
    "lint": "npm run lint",
    "typecheck": "npx tsc --noEmit",
    "test": "npm test",
    "mutate": "npx stryker run"
  },
  "qa_driver": "native",
  "mutation_note": "Stryker.",
  "lanes": [
    {
      "id": "tests",
      "label": "Tests",
      "match": [
        "(^|/)(test|tests|__tests__|e2e|integration_test)/",
        "\\.(test|spec)\\.[jt]sx?$",
        "_test\\.(dart|go|py)$",
        "(^|/)test_[^/]+\\.py$",
        "Tests?\\.(java|kt)$"
      ]
    },
    {
      "id": "ui",
      "label": "UI",
      "match": [
        "/components/",
        "/pages/",
        "/views/"
      ]
    },
    {
      "id": "logic",
      "label": "Source",
      "match": [
        "^src/",
        "^lib/"
      ]
    },
    {
      "id": "config",
      "label": "Config and other",
      "match": [
        ".*"
      ]
    }
  ],
  "test_globs": [
    "test/**",
    "tests/**",
    "__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "production_globs": [
    "src/**",
    "lib/**"
  ],
  "test_report": {
    "kind": "junit-xml",
    "path": "{report_dir}/junit.xml"
  },
  "targeted_test": "JEST_JUNIT_OUTPUT_DIR={report_dir} JEST_JUNIT_OUTPUT_NAME=junit.xml JEST_JUNIT_CLASSNAME='{filename}' JEST_JUNIT_TITLE='{title}' npx jest --ci --reporters=default --reporters=jest-junit {files} -t '{selectors}'",
  "failure_patterns": {
    "compile": [
      "SyntaxError",
      "error TS\\d+"
    ],
    "missing_dependency": [
      "Cannot find module"
    ],
    "environment": [
      "ECONNREFUSED",
      "EACCES"
    ]
  },
  "scenario_ref": "@Scenario\\(\"([^\"]+)\"\\)",
  "test_infra_globs": [
    "jest.config.*",
    "vitest.config.*",
    "jest.setup.*",
    "**/jest.config.*",
    "**/vitest.config.*",
    "**/jest.setup.*"
  ],
  "selector": "{method_re}",
  "selector_join": "|"
}
