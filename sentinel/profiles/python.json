{
  "id": "python",
  "detect": [
    "pyproject.toml",
    "requirements.txt"
  ],
  "commands": {
    "build": "",
    "lint": "ruff check .",
    "typecheck": "mypy .",
    "test": "pytest",
    "mutate": "mutmut run"
  },
  "qa_driver": "native",
  "mutation_note": "mutmut.",
  "lanes": [
    {
      "id": "tests",
      "label": "Tests",
      "match": [
        "(^|/)(test|tests|__tests__|e2e|integration_test)/",
        "\\.(test|spec)\\.[jt]sx?$",
        "_test\\.(dart|go|py)$",
        "(^|/)test_[^/]+\\.py$",
        "Tests?\\.(java|kt)$"
      ]
    },
    {
      "id": "api",
      "label": "Routes and schemas",
      "match": [
        "(^|/)(routes|routers|api|views|schemas)/"
      ]
    },
    {
      "id": "database",
      "label": "Migrations",
      "match": [
        "(^|/)(migrations|alembic)/"
      ]
    },
    {
      "id": "logic",
      "label": "Source",
      "match": [
        "\\.py$"
      ]
    },
    {
      "id": "config",
      "label": "Config and other",
      "match": [
        ".*"
      ]
    }
  ],
  "test_globs": [
    "tests/**",
    "test/**",
    "**/test_*.py",
    "**/*_test.py",
    "**/conftest.py"
  ],
  "production_globs": [
    "**/*.py"
  ],
  "test_report": {
    "kind": "junit-xml",
    "path": "{report_dir}/junit.xml"
  },
  "targeted_test": "pytest -p no:cacheprovider --junitxml={report_dir}/junit.xml {selectors}",
  "failure_patterns": {
    "compile": [
      "SyntaxError",
      "IndentationError"
    ],
    "missing_dependency": [
      "ModuleNotFoundError",
      "No module named"
    ],
    "environment": [
      "Connection refused",
      "Permission denied"
    ],
    "assertion": [
      "AttributeError"
    ]
  },
  "scenario_ref": "@Scenario\\(\"([^\"]+)\"\\)",
  "test_infra_globs": [
    "conftest.py",
    "**/conftest.py",
    "pytest.ini",
    "tox.ini",
    "setup.cfg"
  ],
  "selector": "'{node}'",
  "summary_patterns": [
    "(?P<passed>\\d+) passed",
    "(?P<failed>\\d+) failed",
    "(?P<failed>\\d+) errors?\\b",
    "(?P<skipped>\\d+) skipped"
  ]
}
