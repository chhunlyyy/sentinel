{
  "id": "spring-gradle",
  "detect": [
    "build.gradle",
    "build.gradle.kts"
  ],
  "commands": {
    "build": "./gradlew build -q",
    "lint": "",
    "typecheck": "",
    "test": "./gradlew test",
    "mutate": "./gradlew pitest"
  },
  "qa_driver": "native",
  "mutation_note": "PIT via info.solidsoft.pitest.",
  "lanes": [
    {
      "id": "tests",
      "label": "Tests",
      "match": [
        "(^|/)(test|tests|__tests__|e2e|integration_test)/",
        "\\.(test|spec)\\.[jt]sx?$",
        "_test\\.(dart|go|py)$",
        "(^|/)test_[^/]+\\.py$",
        "Tests?\\.(java|kt)$"
      ]
    },
    {
      "id": "database",
      "label": "Migrations",
      "match": [
        "/db/migration",
        "\\.sql$"
      ]
    },
    {
      "id": "i18n",
      "label": "Messages",
      "match": [
        "(^|/)messages[^/]*\\.properties$"
      ]
    },
    {
      "id": "api",
      "label": "Controllers and API DTOs",
      "match": [
        "/controller/.*\\.(java|kt)$",
        "/dto/(request|response)/.*\\.(java|kt)$"
      ]
    },
    {
      "id": "service",
      "label": "Services, entities, repositories",
      "match": [
        "\\.(java|kt)$"
      ]
    },
    {
      "id": "config",
      "label": "Config and other",
      "match": [
        ".*"
      ]
    }
  ],
  "http_server": "spring",
  "test_globs": [
    "src/test/**"
  ],
  "production_globs": [
    "src/main/**"
  ],
  "test_report": {
    "kind": "junit-xml",
    "path": "build/test-results/test/*.xml"
  },
  "targeted_test": "./gradlew test {selectors}",
  "busy_paths": [
    "build/test-results/test/binary/in-progress-results-generic.bin"
  ],
  "failure_patterns": {
    "compile": [
      "error: cannot find symbol",
      "error: package .* does not exist",
      "Compilation failed"
    ],
    "missing_dependency": [
      "Could not resolve",
      "Could not find"
    ],
    "environment": [
      "Connection refused",
      "Permission denied"
    ]
  },
  "scenario_ref": "@Scenario\\(\"([^\"]+)\"\\)",
  "test_infra_globs": [
    "build.gradle*",
    "settings.gradle*",
    "**/build.gradle*",
    "**/settings.gradle*",
    "gradle.properties"
  ],
  "selector": "--tests '*{test}'",
  "selector_join": " "
}
